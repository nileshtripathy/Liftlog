# Copy to .env (never commit .env). See README for where each value comes from.

# Neon POOLED connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon DIRECT connection string (no "-pooler"). Used only by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/neondb?sslmode=require"

# Generate with: openssl rand -base64 32   (must be at least 32 characters)
BETTER_AUTH_SECRET=""

# Public URL of this app. On Vercel previews it falls back to https://$VERCEL_URL.
BETTER_AUTH_URL="http://localhost:3000"

# Optional: extra comma-separated origins allowed to call the auth API.
# BETTER_AUTH_TRUSTED_ORIGINS=""
